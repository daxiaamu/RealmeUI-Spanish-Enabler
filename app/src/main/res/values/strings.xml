    <string name="guide_title">选择授权方式</string>
    <string name="guide_subtitle">首次使用需要选择一种权限服务。授权成功后会记住选择。</string>
    <string name="choose_root">使用 ROOT</string>
    <string name="root_description">适用于 Magisk、KernelSU 或 APatch，应用将请求超级用户权限。</string>
    <string name="choose_shizuku">使用 Shizuku</string>
    <string name="shizuku_description">无需 ROOT，但需要先启动 Shizuku，并允许本应用访问。</string>
    <string name="choose_axmanager">使用 AxManager</string>
    <string name="axmanager_description">无需 ROOT；请先在 AxManager 中启动服务并开启“AX-Permission Intercept”。</string>
